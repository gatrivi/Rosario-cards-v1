# Copy to .env.local (gitignored). Restart npm start after edits.
# Project: rosario-cards. Without these, art still works locally + jsonblob if sync ID.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=rosario-cards.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=rosario-cards
REACT_APP_FIREBASE_STORAGE_BUCKET=rosario-cards.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
