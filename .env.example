# Copy to .env.local (gitignored). Restart npm start after edits.
# Project: rosario-cards. Without Firebase, prayer still works locally.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=rosario-cards.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=rosario-cards
REACT_APP_FIREBASE_STORAGE_BUCKET=rosario-cards.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Optional. POST-only endpoint owned by us for feedback intake.
# When empty, Feedback uses Web Share / clipboard and sends nothing to a public bucket.
REACT_APP_FEEDBACK_URL=

# Optional. When empty, the donation button stays hidden.
# Prefer a mobile-safe HTTPS destination such as a Mercado Pago payment link.
REACT_APP_DONATION_URL=
