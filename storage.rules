rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Curated public assets remain readable by prayer clients.
    // Public clients cannot upload, replace, or delete canonical art.
    match /art/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Shared voice remains playable, but publication is closed until a trusted
    // submission/moderation path exists. Local recording continues in IndexedDB.
    match /voice/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
