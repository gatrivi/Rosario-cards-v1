rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEMP open rules for art curation. Tighten with Auth later.
    match /shared/{docId} {
      allow read, write: if true;
    }
    match /users/{syncId}/meta/{docId} {
      allow read, write: if true;
    }
  }
}
